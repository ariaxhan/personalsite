---
import Base from '../layouts/Base.astro';
import { format, getCases, getCopy, localePath, type Locale } from '../content';
import { SITE, caseLinks, caseSlugs, type CaseSlug } from '../content/data';
interface Props { locale: Locale; slug: CaseSlug }
const { locale, slug } = Astro.props;
const t = getCopy(locale);
const cases = getCases(locale);
const c = cases[slug];
const nextSlug = caseSlugs[(caseSlugs.indexOf(slug) + 1) % caseSlugs.length];
const next = cases[nextSlug];
const link = caseLinks[slug];
const ld = [{ '@type': 'CreativeWork', name: c.name, description: c.intro, url: SITE + localePath(locale, '/projects/' + slug + '/'), creator: { '@id': `${SITE}/#person` }, inLanguage: locale }];
---
<Base locale={locale} title={format(t.meta.caseTitle, { name: c.name })} description={c.intro} ld={ld}>
  <div class="page-top"><a class="back" href={localePath(locale, '/work/')}>{t.common.allWork}</a><p class="eyebrow">{c.eyebrow}</p><h1>{c.name}</h1><p class="intro">{c.intro}</p></div>
  <dl class="case-details">{c.details.map((d) => <div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl>
  <div class="case-body"><div class="case-columns">
    <aside class="case-aside"><p class="eyebrow">{t.common.caseStudy}</p><h2>{t.common.closer}</h2><p>{t.common.closerNote}</p></aside>
    <article class="case-story">
      {c.sections.map((s) => <section><p class="eyebrow">{s.label}</p><h2>{s.title}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</section>)}
      <div class="case-highlight"><span class="eyebrow">{t.common.keyPoint}</span><strong>{c.highlight.title}</strong><p>{c.highlight.body}</p></div>
      <div class="case-panel"><p class="eyebrow">{t.common.atGlance}</p><div class="case-flow">{c.flow.map((f, i) => <Fragment>{i > 0 && <span aria-hidden="true" class="sep">→</span>}<span class="case-node">{f}</span></Fragment>)}</div></div>
      <p class="case-note">{c.note}</p>
      {link && <a class="pill" href={link.href} rel="noopener noreferrer" target="_blank">{format(t.common.explore, { label: link.label })}</a>}
    </article>
  </div></div>
  <section class="case-next"><div class="card"><div><p class="eyebrow">{t.common.next}</p><h2>{next.name}</h2><p>{next.intro}</p></div><a class="pill" href={localePath(locale, `/projects/${nextSlug}/`)}>{t.common.readProject}</a></div></section>
</Base>
