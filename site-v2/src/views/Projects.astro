---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
import { format, getCopy, localePath, type Locale } from '../content';
import { projects, type ProjectGroup } from '../content/data';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const pp = t.projectsPage;
const groups: ProjectGroup[] = ['systems', 'products', 'companies'];
---
<Base locale={locale} title={t.meta.projectsTitle} description={t.meta.projectsDescription}>
  <PageTop eyebrow={format(pp.count, { count: projects.length })} heading={pp.heading} intro={pp.intro} emphasis={1} />
  {groups.map((g) => (
    <section class="list-section" aria-labelledby={`g-${g}`} id={g}>
      <h2 id={`g-${g}`}>{pp.groups[g]}</h2>
      <ul class="entries">
        {projects.filter((p) => p.group === g).map((p) => {
          const c = t.projects[p.name];
          return (
            <li>
              <h3>{p.name}</h3>
              <p>{c.line}<span class="proof">{c.proof}</span></p>
              <div>
                <span class="row-meta">{c.status}</span>
                <div class="entry-links">
                  {p.caseSlug && <a href={localePath(locale, `/projects/${p.caseSlug}/`)}>{t.common.caseStudyLink} ↗</a>}
                  {p.links.map((l) => <a href={l.href} rel="noopener noreferrer" target="_blank">{l.label}</a>)}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
