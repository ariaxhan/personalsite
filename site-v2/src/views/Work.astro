---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import PageTop from '../components/PageTop.astro';
import { getCopy, localePath, type Locale } from '../content';
import { caseSlugs } from '../content/data';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const w = t.work;
---
<Base locale={locale} title={t.meta.workTitle} description={t.meta.workDescription}>
  <PageTop eyebrow={w.eyebrow} heading={w.heading} intro={w.intro} emphasis={1} />
  <section class="work-page">
    <div class="page-preface"><h2>{w.prefaceHeading}</h2><p>{w.prefaceNote}</p></div>
    <div class="cards">{caseSlugs.map((slug) => <CaseCard slug={slug} locale={locale} />)}</div>
    <div class="page-preface" style="padding-top:0;padding-bottom:80px"><a class="pill work-all" style="margin-top:0" href={localePath(locale, '/projects/')}>{w.allProjects}</a></div>
  </section>
</Base>
