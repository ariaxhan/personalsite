---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
import { getCopy, localePath, type Locale } from '../content';
import { social } from '../content/data';
import Bookshelf from '../components/Bookshelf.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const a = t.about;
const l = a.linksLine;
const u = 'text-decoration:underline';
---
<Base locale={locale} title={t.meta.aboutTitle} description={t.meta.aboutDescription}>
  <PageTop eyebrow={a.eyebrow} heading={a.heading} intro={a.intro} emphasis={1} />
  <section class="about-page">
    <p class="eyebrow">{a.backgroundEyebrow}</p>
    <h2>{a.backgroundHeading}</h2>
    {a.paragraphs.map((p) => <p>{p}</p>)}
    <div class="about-facts">{a.facts.map((f) => <div class="about-fact"><b>{f.n}</b><span>{f.label}</span></div>)}</div>
    <p style="margin-top:60px">{l[0]}<a href={localePath(locale, '/experience/')} style={u}>{l[1]}</a>{l[2]}<a href={localePath(locale, '/hackathons/')} style={u}>{l[3]}</a>{l[4]}<a href={social[1].href} rel="noopener noreferrer" target="_blank" style={u}>{l[5]}</a>{l[6]}<a href={social[0].href} rel="noopener noreferrer" target="_blank" style={u}>{l[7]}</a>{l[8]}</p>
  </section>
  <section aria-labelledby="books-heading" class="about-block books-block" id="bookshelf">
    <h2 id="books-heading">{a.booksHeading}</h2>
    <Bookshelf locale={locale} />
  </section>
  <section aria-labelledby="obsessions-heading" class="about-block obsessions-block" id="obsessions">
    <h2 id="obsessions-heading">{a.obsessionsHeading}</h2>
    <ul class="chips">{a.obsessions.map((o) => <li>{o}</li>)}</ul>
  </section>
  <section aria-labelledby="map-heading" class="about-block map-block" id="curiosity-map">
    <h2 id="map-heading">{a.mapHeading}</h2>
    <p class="count-line">{a.mapNote}</p>
    <ul class="pursuits">{a.pursuits.map((p) => <li><h3>{p.name}</h3><p>{p.blurb}</p></li>)}</ul>
  </section>
</Base>
