---
import Base from '../layouts/Base.astro';
import { getCopy, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale);

const wins = [
  { name: 'Darwin', href: 'https://devpost.com/software/darwin-cmfysv' },
  { name: 'Armature', href: 'https://devpost.com/software/the-convergence' },
  { name: 'Content Creator Connector', href: 'https://devpost.com/software/content-creator-connector' },
  { name: 'TheraVoice', href: 'https://devpost.com/software/draft_name' },
  { name: 'Best Use of Wordware', href: null },
] as const;
---
<Base locale={locale} title={t.meta.aboutTitle} description={t.meta.aboutDescription}>
  <section class="section about">
    <h1>{t.about.headingLine1}<br />{t.about.headingLine2}</h1>
    <div class="about-copy">
      {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <a class="pill" href="mailto:ariaxhan@gmail.com">ariaxhan@gmail.com</a>
    </div>
  </section>
  <section class="section wins">
    <div class="section-head">
      <h2>{t.about.winsHeading}</h2>
      <p class="smallnote">{t.about.winsNote}</p>
    </div>
    <ul class="win-list">
      {wins.map((w) => (
        <li>{w.href ? <a href={w.href}><strong>{w.name}</strong><span>{t.about.wins[w.name]}</span></a> : <div class="win-card"><strong>{w.name}</strong><span>GPT-4o vs. Gemini 1.5 Hackathon, 2024<br />{t.about.wins[w.name]}</span></div>}</li>
      ))}
    </ul>
  </section>
</Base>
