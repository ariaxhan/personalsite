---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { format, getCopy, localePath, type Locale } from '../content';
import { liveCount, motionStats } from '../content/data';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const h = t.home;
const n = (v: number) => v.toLocaleString('en-US');
const stats = [
  { n: n(motionStats.commits), label: h.stats.commits },
  { n: String(motionStats.repos), label: h.stats.repos },
  { n: String(liveCount), label: h.stats.live },
  { n: '5', label: h.stats.wins },
  { n: '3', label: h.stats.ventures },
  { n: '9', label: h.stats.team },
  { n: '100s', label: h.stats.users },
  { n: '2', label: h.stats.languages },
];
const featured = ['heycontext', 'kernel', 'modelmind', 'thinking-brain-school'] as const;
---
<Base locale={locale} title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <section aria-labelledby="hero-title" class="hero" id="top">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title">{h.hero[0]}<br />{h.hero[1]}<br /><span>{h.hero[2]}<br />{h.hero[3]}</span></h1>
      <p class="lede">{h.lede}</p>
      <div class="hero-cta">
        <a class="pill" href={localePath(locale, '/work/')}>{h.seeWork}</a>
        <a class="pill pill-alt" href="#approach">{h.howIWork}</a>
      </div>
      <p class="hero-note">{h.heroNote[0]}<br />{h.heroNote[1]}</p>
    </div>
    <div aria-hidden="true" class="star-scene"><div class="orb"></div><div class="star"></div><div class="spark"></div></div>
  </section>
  <section aria-labelledby="work-heading" class="section work" id="work">
    <div class="section-head">
      <h2 id="work-heading">{h.workHeading[0]}<br />{h.workHeading[1]}</h2>
      <p class="smallnote">{h.workNote}</p>
    </div>
    <div class="cards">{featured.map((slug) => <CaseCard slug={slug} locale={locale} />)}</div>
    <a class="pill work-all" href={localePath(locale, '/work/')}>{h.allWork}</a>
  </section>
  <section aria-labelledby="approach-heading" class="section approach" id="approach">
    <p class="eyebrow">{h.approachEyebrow}</p>
    <h2 id="approach-heading">{h.approachHeading[0]}<br />{h.approachHeading[1]}</h2>
    <p class="approach-head">{h.approachHead}</p>
    <div class="steps">{h.steps.map((s) => <div class="step"><small>{s.label}</small><h3>{s.title}</h3><p>{s.body}</p></div>)}</div>
  </section>
  <section aria-labelledby="timeline-heading" class="section timeline" id="timeline">
    <div class="section-head"><h2 id="timeline-heading">{h.timelineHeading[0]}<br />{h.timelineHeading[1]}</h2><p class="smallnote">{h.timelineNote}</p></div>
    <ol class="rows">{t.homeRows.map((r) => <li><span class="row-meta">{r.when}</span><strong>{r.title[0]}<br />{r.title[1]}</strong><div class="row-body">{r.note && <p class="row-note">{r.note}</p>}<ul class="row-points">{r.points.map((p) => <li>{p.lead && <strong>{p.lead} </strong>}{p.text}</li>)}</ul></div></li>)}</ol>
    <div class="education">
      <p class="edu-label">{t.experience.education.heading}</p>
      <ul class="edu-list">{t.experience.education.items.map((s) => <li><span><strong>{s.school}</strong>, {s.field}</span><span class="row-meta">{s.when}</span></li>)}</ul>
    </div>
    <p class="timeline-end">{h.timelineEnd}</p>
    <a class="pill work-all" href={localePath(locale, '/experience/')}>{h.fullExperience}</a>
  </section>
  <section aria-labelledby="proof-heading" class="section stats-section" id="proof">
    <div class="section-head"><h2 id="proof-heading">{h.proofHeading[0]}<br />{h.proofHeading[1]}</h2><p class="smallnote">{h.proofNote}</p></div>
    <dl class="stats stats-8">{stats.map((s) => <div><dt>{s.label}</dt><dd>{s.n}</dd></div>)}</dl>
    <p class="stats-note">{format(h.statsNote, { date: motionStats.generated })}</p>
  </section>
  <section aria-labelledby="about-heading" class="section about" id="about">
    <div><p class="eyebrow">{h.aboutEyebrow}</p><h2 id="about-heading">{h.aboutHeading[0]}<br />{h.aboutHeading[1]}<br />{h.aboutHeading[2]}</h2></div>
    <div class="about-copy">
      {h.aboutCopy.map((p) => <p>{p}</p>)}
      <p class="smaller">{h.aboutSmall}</p>
      <a class="pill" href={localePath(locale, '/about/')}>{h.moreAbout}</a>
    </div>
  </section>
</Base>
