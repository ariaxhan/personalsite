---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/noto-sans-kr/400.css';
import '@fontsource/noto-sans-kr/500.css';
import '@fontsource/noto-sans-kr/700.css';
import '../styles/global.css';
import { getCopy, localePath, type Locale } from '../content';
import { EMAIL, SITE, social } from '../content/data';
import { personLd } from '../content/ld';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Extra schema.org nodes for this page, added to the shared @graph. */
  ld?: object[];
}
const { title, description, locale = 'en', ld = [] } = Astro.props;
const t = getCopy(locale);
const path = Astro.url.pathname;
const basePath = path.replace(/^\/ko(?=\/)/, '');
const isNotFound = basePath.startsWith('/404');
const otherLocale: Locale = locale === 'ko' ? 'en' : 'ko';
const hrefFor = (target: Locale) => new URL(localePath(target, basePath), SITE).href;
const canonical = new URL(path, SITE).href;
// Cloudflare Pages sets CF_PAGES_BRANCH at build time. Preview deployments
// (any branch other than main) must never be indexed: a stale preview was
// showing up in brand search results in Nov 2026.
const isPreview = import.meta.env.CF_PAGES_BRANCH !== undefined && import.meta.env.CF_PAGES_BRANCH !== 'main';
const ogImage = `${SITE}/og-image.png`;
const current = (prefix: string) => (basePath.startsWith(prefix) ? 'page' : undefined);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    personLd,
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Aria Han', inLanguage: ['en', 'ko'], publisher: { '@id': `${SITE}/#person` } },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: locale, isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': `${SITE}/#person` } },
    ...ld,
  ],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1c1721" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    {/* Cloudflare Web Analytics (RUM site bf9034eac52e45528860dd1f914f35fd); production only so preview traffic stays out of analytics */}
    {!isPreview && <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "87d58633d1cd4b95b937da479b6b3e2d"}'></script>}
    <link rel="canonical" href={canonical} />
    {!isNotFound && <link rel="alternate" hreflang="en" href={hrefFor('en')} />}
    {!isNotFound && <link rel="alternate" hreflang="ko" href={hrefFor('ko')} />}
    {!isNotFound && <link rel="alternate" hreflang="x-default" href={hrefFor('en')} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Aria Han: Product strategy, people and AI systems" />
    <meta property="og:site_name" content="Aria Han" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Aria Han: Product strategy, people and AI systems" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!isNotFound && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="nav">
      <a aria-label={t.nav.home} class="logo" href={localePath(locale, '/')}>aria<span>xhan</span></a>
      <nav aria-label={t.nav.main} class="navlinks">
        <a href={localePath(locale, '/work/')} aria-current={current('/work/') ?? current('/projects/')}>{t.nav.work}</a>
        <a class="nav-experience" href={localePath(locale, '/experience/')} aria-current={current('/experience/')}>{t.nav.experience}</a>
        <a class="nav-about" href={localePath(locale, '/about/')} aria-current={current('/about/')}>{t.nav.about}</a>
        <a class="nav-writing" href={localePath(locale, '/writing/')} aria-current={current('/writing/')}>{t.nav.writing}</a>
        <a aria-label={t.nav.language} class="lang" href={localePath(otherLocale, isNotFound ? '/' : basePath)} hreflang={otherLocale} lang={otherLocale}>{otherLocale === 'ko' ? 'KR' : 'EN'}</a>
        <a class="pill" href="#contact">{t.nav.talk}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer" id="contact">
      <p class="eyebrow">{t.footer.eyebrow}</p>
      <h2>{t.footer.heading[0]}<br />{t.footer.heading[1]}</h2>
      <p class="footer-mail"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      <div class="footerline">
        <span>&copy; {new Date().getFullYear()} Aria Han · {t.footer.note}</span>
        <div class="footerlinks">
          <a href={localePath(locale, '/hackathons/')}>{t.footer.hackathons}</a>
          <a href={localePath(locale, '/projects/')}>{t.footer.projects}</a>
          <a href={localePath(locale, '/work-with-me/')}>{t.footer.workWithMe}</a>
          {social.map((s) => <a href={s.href} rel="noopener noreferrer" target="_blank">{s.label}</a>)}
        </div>
      </div>
    </footer>
  </body>
</html>
