---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { groups, projects } from '../../data/projects';
---
<Base
  title="Projects | Aria Han, AI Architect"
  description="Twenty projects by Aria Han across agent systems, memory, evals, and shipped products."
>
  <section class="page-head">
    <p class="eyebrow">{projects.length} projects</p>
    <h1>All the<br /><span>good stuff.</span></h1>
  </section>
  {groups.map((group) => {
    const items = projects.filter((p) => p.group === group);
    return (
      <section class="section group">
        <div class="section-head">
          <h2>{group}</h2>
          <p class="smallnote">{items.length} projects</p>
        </div>
        <div class="cards">
          {items.map((p) => <ProjectCard project={p} label={p.status} />)}
        </div>
      </section>
    );
  })}
</Base>
