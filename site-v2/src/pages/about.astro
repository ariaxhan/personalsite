---
import Base from '../layouts/Base.astro';

const wins = [
  { name: 'Darwin', line: 'Models compete to generate tools. Weak code dies. Strong code survives.', href: 'https://devpost.com/software/darwin-cmfysv' },
  { name: 'Armature', line: 'Self-improving agents that learn from experience.', href: 'https://devpost.com/software/the-convergence' },
  { name: 'Content Creator Connector', line: 'Finds the right creators, researches your brand, and writes the outreach.', href: 'https://devpost.com/software/content-creator-connector' },
  { name: 'TheraVoice', line: 'A voice-first therapy prototype that reasons and speaks back.', href: 'https://devpost.com/software/draft_name' },
  { name: 'HotAgents', line: 'Trigger agents with hotkeys.', href: 'https://github.com/ariaxhan/hotagents' },
];
---
<Base
  title="About | Aria Han, AI Architect"
  description="Aria Han is an AI architect and CTO at Thinking Brain School, designing and running autonomous AI systems end to end."
>
  <section class="section about">
    <h1>Hi, I'm<br />Aria.</h1>
    <div class="about-copy">
      <p>Part architect, part systems thinker, part compulsive maker.</p>
      <p>I started as a language person. Then language models arrived, and the language part and the machine part stopped feeling separate.</p>
      <p>My career has been a sequence of frictions. I live with something until it annoys me enough to build a system around it, usually one that does the mechanical work so the person doesn't have to.</p>
      <p>Today I'm CTO at Thinking Brain School, where I lead the design and operation of its autonomous AI system: architecture, orchestration, quality controls, and making sure the work is verifiable.</p>
      <a class="pill" href="mailto:ariaxhan@gmail.com">ariaxhan@gmail.com</a>
    </div>
  </section>
  <section class="section wins">
    <div class="section-head">
      <h2>Five wins.</h2>
      <p class="smallnote">Built under pressure.</p>
    </div>
    <ul class="win-list">
      {wins.map((w) => (
        <li><a href={w.href}><strong>{w.name}</strong><span>{w.line}</span></a></li>
      ))}
    </ul>
  </section>
</Base>
