---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { featured, projects } from '../data/projects';
import motion from '../../../app/utils/motionData.json';

const liveProjects = projects.filter((p) => /^(Live|Playable online)/.test(p.status));

const stats = [
  { n: motion.grandTotal.toLocaleString('en-US'), label: 'Commits' },
  { n: String(motion.repoCount), label: 'Repositories' },
  { n: '5', label: 'Hackathon wins' },
  { n: String(liveProjects.length), label: 'Live projects' },
];

const monthly = new Map<string, number>();
for (const series of motion.series) {
  for (const [month, count] of Object.entries(series.months)) {
    monthly.set(month, (monthly.get(month) ?? 0) + Number(count));
  }
}
const months = [...monthly].sort(([a], [b]) => a.localeCompare(b));
const peak = Math.max(...months.map(([, count]) => count));

const timeline = [
  { when: '2026', title: 'CTO, Thinking Brain School', line: 'Leading the autonomous AI system behind an AI-first education company.' },
  { when: '2026', title: 'Lead AI Architect, FunJoin', line: 'Internal AI tools for onboarding, retrieval, and development.' },
  { when: '2026', title: 'Independent consultant and researcher', line: 'Hardened real apps for non-technical founders.' },
  { when: '2025', title: 'PersistOS / HeyContext', line: 'A multi-agent workspace. Hundreds of users within a month, no ad spend.' },
  { when: '2025', title: 'Divertissement / HeyContent', line: 'Cross-platform memory and persona creation.' },
  { when: '2024', title: 'Brink Labs / Brink Mind', line: 'Voice AI and Apple Watch biometrics for mental health.' },
  { when: '2024', title: 'Five hackathon wins', line: 'Each one built in 24 to 48 hours.' },
  { when: '2024', title: 'Published author', line: 'Notes on Surviving Eternity, a poetry collection.' },
];

const writing = [
  { topic: 'AI agents', title: 'Grok Bot: Cursor\u2019s Bet on Multi-Agent AI', href: 'https://medium.com/@ariaxhan/grok-bot-cursors-bet-on-multi-agent-ai-77d69ba8b290' },
  { topic: 'Memory', title: 'Stop Writing Markdown. Start Writing Memory.', href: 'https://medium.com/@ariaxhan/stop-writing-markdown-start-writing-memory-e4a69c57caa9' },
  { topic: 'Evals', title: 'Claude vs. GPT vs. Gemini: You\u2019re Benchmarking the Wrong Thing', href: 'https://medium.com/@ariaxhan/claude-vs-gpt-vs-gemini-youre-benchmarking-the-wrong-thing-762c7e9cca5d' },
  { topic: 'AI coding', title: 'I Stopped Debugging Claude\u2019s Code and Started Debugging My Prompts Instead', href: 'https://medium.com/@ariaxhan/how-i-stopped-debugging-ai-generated-code-1be33241b3c8' },
  { topic: 'The novel', title: 'The Correction', href: 'https://www.amazon.com/dp/B0HKVKNBL9' },
];
---
<Base
  title="Aria Han | AI Architect"
  description="Aria Han designs and runs autonomous AI systems end to end: architecture, orchestration, memory, evals, and verifiable receipts."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Aria Han / CTO, Thinking Brain School</p>
      <h1>AI<br /><span>Architect.</span></h1>
      <p class="lede">I design and run autonomous AI systems end to end: architecture, orchestration, memory, evals, and verifiable receipts. Humans review where judgment matters.</p>
      <div class="hero-cta">
        <a href="#talk" class="pill">Book a call <span aria-hidden="true">&rarr;</span></a>
        <a href="#work" class="pill pill-alt">See the work</a>
      </div>
      <SocialLinks />
    </div>
    <div class="star-scene" aria-hidden="true">
      <div class="orb"></div>
      <div class="star"></div>
      <div class="spark"></div>
    </div>
  </section>

  <section class="section work" id="work">
    <div class="section-head">
      <h2>The good<br />stuff.</h2>
      <p class="smallnote">Eight of {projects.length} projects. Built, broken, rebuilt, shipped.</p>
    </div>
    <div class="cards">
      {featured.map((p, i) => (
        <ProjectCard project={p} label={`${String(i + 1).padStart(2, '0')} / ${p.featured!.tag}`} />
      ))}
    </div>
    <a href="/projects/" class="pill work-all">All {projects.length} projects <span aria-hidden="true">&rarr;</span></a>
  </section>
  <section class="section proof-section" id="proof">
    <div class="section-head">
      <h2>Proof.</h2>
      <p class="smallnote">The record, not the claim.</p>
    </div>
    <dl class="stats">
      {stats.map((s) => (
        <div><dt>{s.label}</dt><dd>{s.n}</dd></div>
      ))}
    </dl>
    <div class="bars" role="img" aria-label={`Monthly commits from ${months[0][0]} to ${months[months.length - 1][0]}, peaking at ${peak.toLocaleString('en-US')} in a month.`}>
      {months.map(([, count]) => <span style={`height:${Math.max(3, (count / peak) * 100)}%`}></span>)}
    </div>
    <p class="smallnote bars-note">Commits per month, from GitHub. Updated {motion.generated}.</p>
    <a href="https://github.com/ariaxhan" class="pill work-all">See the commits on GitHub <span aria-hidden="true">&nearr;</span></a>
  </section>

  <section class="section timeline" id="timeline">
    <div class="section-head">
      <h2>Timeline.</h2>
    </div>
    <ol class="rows">
      {timeline.map((t) => (
        <li><span class="row-meta">{t.when}</span><strong>{t.title}</strong><span>{t.line}</span></li>
      ))}
    </ol>
  </section>

  <section class="section writing" id="writing">
    <div class="section-head">
      <h2>Writing.</h2>
    </div>
    <ul class="rows">
      {writing.map((w) => (
        <li><span class="row-meta">{w.topic}</span><a href={w.href}><strong>{w.title}</strong></a></li>
      ))}
    </ul>
    <a href="https://medium.com/@ariaxhan" class="pill work-all">All writing <span aria-hidden="true">&rarr;</span></a>
  </section>
</Base>
